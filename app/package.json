{
  "name": "freshgroove-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/server.ts",
    "db:generate": "drizzle-kit generate",
    "typegen": "appkit generate-types",
    "sync": "appkit plugin sync --write",
    "build:server": "tsdown --config tsdown.server.config.ts",
    "build:client": "vite build --config client/vite.config.ts",
    "build:source": "npm run build:server && npm run build:client",
    "build": "echo 'build skipped in-container — dist/ + client/dist/ are prebuilt locally and shipped'",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@databricks/appkit": "^0.66.1",
    "@databricks/appkit-ui": "^0.66.1",
    "@openai/agents": "^0.17.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.5.4",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.2",
    "jsonc-parser": "^3.3.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.33.0",
    "mlflow-tracing": "^0.1.3",
    "openai": "^5.0.0",
    "pg": "^8.18.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.9.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.15",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.1.1",
    "drizzle-kit": "^0.31.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.0",
    "typescript": "~5.6.3",
    "vite": "^7.2.4",
    "vitest": "^4.1.0"
  }
}
